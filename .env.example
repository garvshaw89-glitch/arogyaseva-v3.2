# AROGYASEVA PUBLIC ENVIRONMENT CONFIGURATION
# Only safe, public configuration safe for client-side inclusion (VITE_ prefix)

# 1. Cloud Supabase Configuration (Public Anon Key & Public Project URL)
# Safe for client inclusion: Supabase client-side anon key enforces Row-Level Security (RLS) on the database
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# 2. Production Cloud WebSocket Relay Endpoint (Optional for multi-network production deployment)
# Example: wss://api.arogyaseva.org/ws
VITE_WEBSOCKET_URL=wss://api.arogyaseva.org/ws

# 3. Environment Name
VITE_APP_ENV=production
